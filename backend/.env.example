# ─── Database ─────────────────────────────────────────────────────────────────
# Direct connection string from Supabase → Project Settings → Database
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?user=postgres&password=<your-db-password>
SUPABASE_DB_PASSWORD=<your-db-password>

# ─── Supabase Storage ─────────────────────────────────────────────────────────
# Project URL — Supabase dashboard → Settings → API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co
# service_role secret — Supabase dashboard → Settings → API → service_role (NOT the anon key)
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
# Bucket name — create in Supabase dashboard → Storage
SUPABASE_STORAGE_BUCKET=documents

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a random 256-bit hex key: openssl rand -hex 32
JWT_SECRET_KEY=<your-256-bit-hex-secret>
